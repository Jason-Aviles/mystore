  netlify login,# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Two separate places need configuring for the LIVE site:
#   1. Netlify env vars  -> only the VITE_* values below (they build into the JS)
#   2. Supabase secrets  -> everything under "Server-side" (`supabase secrets set`)
# See DEPLOY-ENV.md for the exact live values and steps.

# ============ Frontend (Vite — compiled into the browser bundle) ============
# Supabase project -> Settings -> API. The anon/publishable key is meant to be
# public; row-level security is what protects your data.
# REQUIRED IN NETLIFY: without these the site silently falls back to demo mode
# and the admin panel will not accept your real account.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Demo-mode admin passcode. Only used when Supabase is NOT configured.
# Leave this OUT of Netlify — with Supabase connected, real Auth takes over,
# and shipping a passcode to production is a needless backdoor.
VITE_ADMIN_PASSCODE=change-me

# PayPal Smart Buttons (developer.paypal.com -> My Apps -> Live Client ID).
# Blank = the PayPal option is hidden.
VITE_PAYPAL_CLIENT_ID=

# Meta Ads Pixel ID (Meta Events Manager). Blank = tracking off.
VITE_META_PIXEL_ID=

# ============ Server-side (Edge Functions + scripts) ============
# NEVER prefix any of these with VITE_ — that would publish them to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Account-level token used by the Supabase CLI to deploy schema and functions.
SUPABASE_ACCESS_TOKEN=

# Stripe (dashboard.stripe.com -> Developers -> API keys). Used only by the
# create-checkout / stripe-webhook / charge-balance functions:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx STRIPE_WEBHOOK_SECRET=whsec_xxx
# Webhook endpoint: https://YOUR-PROJECT.supabase.co/functions/v1/stripe-webhook
#   Events: checkout.session.completed, invoice.paid
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend (resend.com) — transactional + campaign email.
# Nothing sends until your sending domain is verified in Resend.
RESEND_API_KEY=
RESEND_FROM=contact@yourdomain.com

# "You got a sale" alert, sent to you by the stripe-webhook function.
# Blank skips that channel; the phone alert also requires Twilio below.
OWNER_SALE_EMAIL=
OWNER_SALE_PHONE=

# Twilio SMS — nothing sends until all three are set.
# The functions read TWILIO_FROM. A key named TWILIO_FROM_NUMBER is ignored.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# PayPal server capture — Supabase Edge Function secrets (npm run secrets:paypal)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
