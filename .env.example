# ============ Frontend (Vite — exposed to browser, use anon/public keys only) ============
# Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin fallback passcode — ONLY used when Supabase is not configured (demo mode).
# With Supabase connected, admin uses real Supabase Auth accounts instead.
VITE_ADMIN_PASSCODE=change-me

# PayPal Smart Buttons (developer.paypal.com → My Apps → Create App → Live Client ID).
# Renders a real PayPal button at checkout; funds land in your PayPal business account.
# Leave blank to hide the PayPal option.
VITE_PAYPAL_CLIENT_ID=

# ============ Import script + Edge Functions (server-side only, NEVER prefix with VITE_) ============
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (dashboard.stripe.com → Developers → API keys)
# Secret key is used ONLY by the create-checkout / stripe-webhook Edge Functions:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx STRIPE_WEBHOOK_SECRET=whsec_xxx
# Webhook: Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://YOUR-PROJECT.supabase.co/functions/v1/stripe-webhook
#   Event: checkout.session.completed   → copy its signing secret to STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend (resend.com) — for campaign + transactional email
RESEND_API_KEY=
RESEND_FROM=

# Twilio — leave blank until you're ready; nothing sends without these
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=



# Meta Ads Pixel ID (from Meta Events Manager) — blank = tracking off
VITE_META_PIXEL_ID=
